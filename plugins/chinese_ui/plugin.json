{
  "id": "chinese_ui",
  "name": "Chinese UI",
  "version": "1.1.2",
  "api": 1,
  "use": "both",
  "category": "tools",
  "entry": "plugin:ChineseUI",
  "author": "xpilot",
  "description": "Simplified Chinese UI with a bundled font. Enable or disable, then restart the UI. No driving behavior changes.",
  "priority": 100,
  "enable_param": "ExtChineseUI",
  "claims": [
    "role:ui.language"
  ],
  "requires": {
    "hooks": [
      "ui_language"
    ],
    "params_abi": 1
  },
  "params": {
    "ExtChineseUI": {
      "type": "BOOL",
      "default": "0",
      "aliases": [
        "XpilotChineseUI"
      ]
    }
  }
}
